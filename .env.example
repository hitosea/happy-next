# Happy Next - docker-compose environment
#
# Usage:
# 1) Copy this file to `.env`
# 2) Fill in required values
# 3) Run: `docker-compose up -d`
#
# Notes:
# - Do NOT commit `.env` (it is gitignored)
# - This file is safe to commit: it contains placeholders only
#
# Ports (from docker-compose.yml):
# - Web app (Nginx): http://localhost:3030
# - API server:      http://localhost:3031
# - Voice gateway:   http://localhost:3040
# - MinIO/S3:        http://localhost:3050

# === Server (happy-server) ===
# Required. Used to sign auth tokens and seed server-side crypto primitives.
# Generate with a password manager or: `openssl rand -hex 32`
HANDY_MASTER_SECRET=changeme-32-bytes-hex

# Optional. Public service discovery values returned by /v1/app-config.
# Leave blank to make the client fall back to its entry API URL and disable
# voice auto-configuration.
PUBLIC_API_BASE_URL=
# Public URL of happy-voice, reachable by browsers/mobile clients.
PUBLIC_VOICE_BASE_URL=http://localhost:3040
# Shared by happy-server and happy-voice. Generate with a password manager or:
# `openssl rand -hex 32`
VOICE_AUTH_SECRET=changeme-voice-auth-secret-at-least-32-chars

# Optional. Public URL where the web app is served (used in some connect flows).
APP_URL=http://localhost:3030

# === DooPush server relay (happy-server / Docker Compose) ===
# The server relays native notifications through DooPush after verifying that
# the target token belongs to the authenticated account. The App Secret needs
# the push:send scope and must remain server-side.
DOOPUSH_APP_ID=
DOOPUSH_APP_SECRET=
DOOPUSH_BASE_URL=https://doopush.com/api/v1

# === DooPush mobile build (happy-app / EAS) ===
# These variables are a reference for native app builds. Configure them in each
# EAS environment; copying this file to the repository root `.env` does not
# configure EAS. Keep the app and server IDs/base URLs aligned.
EXPO_PUBLIC_DOOPUSH_APP_ID=
# Public registration identifier. This is safe to embed in the mobile app.
EXPO_PUBLIC_DOOPUSH_APP_KEY=
EXPO_PUBLIC_DOOPUSH_BASE_URL=https://doopush.com/api/v1
# Optional APNs entitlement override: development or production. Leave empty to infer it from the build profile.
DOOPUSH_IOS_MODE=
# FCM defaults to packages/happy-app/google-services.json. Override with an EAS
# file secret path when each build environment uses a different Firebase app.
DOOPUSH_FCM_GOOGLE_SERVICES_FILE=./google-services.json
# HMS requires an agconnect-services.json file (use an EAS file secret).
DOOPUSH_HMS_AGCONNECT_SERVICES_FILE=
# Honor supports an mcs-services.json file, appId + developerId, or clientId + clientSecret.
DOOPUSH_HONOR_MCS_SERVICES_FILE=
DOOPUSH_HONOR_APP_ID=
DOOPUSH_HONOR_DEVELOPER_ID=
DOOPUSH_HONOR_CLIENT_ID=
DOOPUSH_HONOR_CLIENT_SECRET=
# Xiaomi, OPPO, VIVO, and Meizu accept either a services file or the inline pair below.
DOOPUSH_XIAOMI_SERVICES_FILE=
DOOPUSH_XIAOMI_APP_ID=
DOOPUSH_XIAOMI_APP_KEY=
DOOPUSH_OPPO_SERVICES_FILE=
DOOPUSH_OPPO_APP_KEY=
DOOPUSH_OPPO_APP_SECRET=
DOOPUSH_VIVO_SERVICES_FILE=
DOOPUSH_VIVO_APP_ID=
DOOPUSH_VIVO_API_KEY=
DOOPUSH_MEIZU_SERVICES_FILE=
DOOPUSH_MEIZU_APP_ID=
DOOPUSH_MEIZU_APP_KEY=

# === Database (Postgres) ===
POSTGRES_DB=happy
POSTGRES_USER=happy
POSTGRES_PASSWORD=changeme-postgres-password

# === Redis ===
# Optional for docker-compose: Redis runs in-compose and happy-server uses it via service name.
# REDIS_URL=redis://redis:6379

# === S3 / MinIO (happy-server) ===
# Required for uploads/artifacts. MinIO runs in-compose and docker-compose
# creates this bucket automatically on first start.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme-minio-secret
S3_BUCKET=happy-server

# Required: must be reachable by *clients* (browser/mobile), not just containers.
# For local compose, MinIO is exposed on port 3050.
S3_PUBLIC_URL=http://localhost:3050/happy-server

# === GitHub OAuth/App (optional) ===
# Leave empty to disable GitHub integration features.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Canonical name used by happy-server (alias: GITHUB_REDIRECT_URI).
# Example (local): http://localhost:3031/v1/connect/github/callback
GITHUB_REDIRECT_URL=

GITHUB_WEBHOOK_SECRET=

# Private key PEM as a single line with \n escapes, or mount via other secret manager.
GITHUB_PRIVATE_KEY=

## === Web app (happy-app, served by Nginx) ===
# Self-host uses separate origins (no path reverse proxy). This is the entry API
# URL used by the web app before it calls /v1/app-config for discovery.
EXPO_PUBLIC_HAPPY_SERVER_URL=http://localhost:3031

# For docker-compose, the gateway must call happy-server by container DNS, not host localhost.
EXPO_PUBLIC_VOICE_TOOL_BRIDGE_BASE_URL=http://happy-server:3031

# === Voice gateway (happy-voice) — 火山引擎 AI 音视频互动方案 (2025-06-01, ArkV3) ===
# Volcano runs ASR → Doubao (streaming) → bidirectional TTS server-side; function
# calls are executed client-side. The gateway only mints RTC tokens + StartVoiceChat.

# 火山 RTC — MUST be an "AI agent" type RTC app.
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=

# 火山 OpenAPI signing (IAM access key — StartVoiceChat / StopVoiceChat)
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_RTC_REGION=cn-north-1
VOLC_RTC_API_VERSION=2025-06-01

# LLM (Doubao via built-in ArkV3, runs inside Volcano)
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
LLM_THINKING_TYPE=disabled

# ASR (seed big-model streaming; auth bound to the agent RTC app)
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# Unified voice/speaker — used by BOTH the live agent TTS and message-playback TTS.
VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts

# Agent TTS (bidirectional streaming for the live conversation). seed-tts-2.0 is
# required for the multilingual voices (uranus).
VOLC_AGENT_TTS_RESOURCE_ID=seed-tts-2.0

# Message-playback TTS (streamed, sentence-by-sentence; speech-console TTS app)
VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
# Pre-TTS cleaning (strip markdown/code/links). LLM cleaning needs ARK_API_KEY;
# otherwise falls back to regex. Streamed so playback starts on the first sentence.
ARK_API_KEY=
TTS_CLEAN_LLM=true
TTS_CLEAN_MODEL=doubao-seed-2-0-lite-260428

# 可用 | 分隔多个，每次进房随机选一条。例：你好，需要我做点什么？|在的，说吧|我在听
AGENT_WELCOME_MESSAGE=你好，需要我做点什么？
DEFAULT_LANGUAGE=zh
