// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "relationJoins"]
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Account
//

model Account {
  id                  String      @id @default(cuid())
  publicKey           String      @unique
  contentPublicKey    Bytes?
  contentPublicKeySig Bytes?
  seq                 Int         @default(0)
  feedSeq             BigInt      @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  settings            String?
  settingsVersion     Int         @default(0)
  githubUserId        String?     @unique
  githubUser          GithubUser? @relation(fields: [githubUserId], references: [id])

  // Profile
  firstName String?
  lastName  String?
  username  String? @unique
  /// [ImageRef]
  avatar    Json?

  // Push notification badge counter
  badgeCount Int @default(0)

  Session             Session[]
  SessionDeletion     SessionDeletion[]
  OrchestratorRun     OrchestratorRun[]
  AccountPushToken    AccountPushToken[]
  TerminalAuthRequest TerminalAuthRequest[]
  AccountAuthRequest  AccountAuthRequest[]
  UsageReport         UsageReport[]
  Machine             Machine[]
  UploadedFile        UploadedFile[]
  ServiceAccountToken ServiceAccountToken[]
  RelationshipsFrom   UserRelationship[]       @relation("RelationshipsFrom")
  RelationshipsTo     UserRelationship[]       @relation("RelationshipsTo")
  Artifact            Artifact[]
  AccessKey           AccessKey[]
  UserFeedItem        UserFeedItem[]
  UserKVStore         UserKVStore[]
  sharedBySessions    SessionShare[]           @relation("SharedBySessions")
  sharedWithSessions  SessionShare[]           @relation("SharedWithSessions")
  publicSessionShares PublicSessionShare[]     @relation("PublicSessionShares")
  blockedFromShares   PublicShareBlockedUser[]
}

model TerminalAuthRequest {
  id                String   @id @default(cuid())
  publicKey         String   @unique
  supportsV2        Boolean  @default(false)
  response          String?
  responseAccountId String?
  responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AccountAuthRequest {
  id                String   @id @default(cuid())
  publicKey         String   @unique
  response          String?
  responseAccountId String?
  responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AccountPushToken {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  token          String   @unique
  provider       String   @default("expo")
  installationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, installationId])
}

//
// Sessions
//

model Session {
  id                String                  @id @default(cuid())
  tag               String
  accountId         String
  account           Account                 @relation(fields: [accountId], references: [id])
  metadata          String
  metadataVersion   Int                     @default(0)
  agentState        String?
  agentStateVersion Int                     @default(0)
  dataEncryptionKey Bytes?
  seq               Int                     @default(0)
  active            Boolean                 @default(true)
  lastActiveAt      DateTime                @default(now())
  /// Time of the newest message; unlike updatedAt it ignores heartbeats, metadata and state writes
  lastMessageAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  messages          SessionMessage[]
  pendingMessages   SessionPendingMessage[]
  usageReports      UsageReport[]
  accessKeys        AccessKey[]
  shares            SessionShare[]
  publicShare       PublicSessionShare?
  capabilities      SessionCapabilities?
  controllerRuns    OrchestratorRun[]       @relation("ControllerRuns")
  resumedExecutions OrchestratorExecution[] @relation("ControllerExecutions")
  workerExecutions  OrchestratorExecution[] @relation("WorkerExecutions")
  /// The session this one continues (a restart, resume or copy of it, named by its CLI). While
  /// that session is offline, this one takes the orchestrator callbacks owed to it
  predecessorSessionId String?

  @@unique([accountId, tag])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([predecessorSessionId])
}

model SessionDeletion {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId String
  deletedAt DateTime @default(now())

  @@unique([accountId, sessionId])
  @@index([accountId, deletedAt(sort: Asc)])
}

//
// Orchestrator
//

model OrchestratorRun {
  id                  String                  @id @default(cuid())
  accountId           String
  account             Account                 @relation(fields: [accountId], references: [id])
  controllerSessionId String?
  controllerSession   Session?                @relation("ControllerRuns", fields: [controllerSessionId], references: [id], onDelete: SetNull)
  title               String
  status              String
  maxConcurrency      Int                     @default(2)
  idempotencyKey      String?
  metadata            Json?
  cancelRequestedAt   DateTime?
  /// The session whose agent cancelled the run, if one did. It knows the run ended, so it is not
  /// owed a callback for it. Cleared when a follow-up reopens the run.
  cancelledBySessionId String?
  completedAt         DateTime?
  /// When a follow-up last reopened the run after it had finished. The executions created since
  /// then are the current round, and their sessions are the ones told when it finishes again.
  reopenedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  tasks               OrchestratorTask[]
  executions          OrchestratorExecution[]
  callbacks           OrchestratorRunCallback[]

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([accountId, status, updatedAt(sort: Desc)])
  @@index([controllerSessionId])
}

model OrchestratorTask {
  id                String                  @id @default(cuid())
  runId             String
  run               OrchestratorRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq               Int
  taskKey           String?
  title             String?
  provider          String
  model             String?
  prompt            String
  workingDirectory  String?
  timeoutMs         Int?
  targetMachineId   String?
  dependsOnTaskKeys String[]                @default([])
  retryMaxAttempts  Int                     @default(1)
  retryBackoffMs    Int                     @default(0)
  nextAttemptAt     DateTime?
  status            String
  outputSummary     String?
  outputText        String?
  /// Shell tasks only: what the command wrote to stderr (`outputText` holds its stdout)
  stderrText        String?
  /// Shell tasks only: where the daemon saved the full stdout when it was too long to keep here
  /// ({ path, chars, lines, complete }); `outputText` is then its last part
  stdoutFile        Json?
  /// Shell tasks only: the same for stderr
  stderrFile        Json?
  /// Transfer tasks only: what arrived at the target ({ path, kind, bytes, files, sha256 })
  transferResult    Json?
  /// The latest execution's result, sealed by its daemon with the orchestrator key. The output
  /// fields above stay empty beside it: the server cannot read what the task did
  sealedResult      String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  executions        OrchestratorExecution[]

  @@unique([runId, seq])
  @@unique([runId, taskKey])
  @@index([runId, status, seq])
  @@index([runId, status, nextAttemptAt, seq])
  @@index([targetMachineId])
}

model OrchestratorExecution {
  id                  String           @id @default(cuid())
  runId               String
  run                 OrchestratorRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId              String
  task                OrchestratorTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workerSessionId     String?
  workerSession       Session?         @relation("WorkerExecutions", fields: [workerSessionId], references: [id], onDelete: SetNull)
  /// The session that sent the follow-up this execution resumes, or the session the retried
  /// execution came from. Null means the run's own controller session.
  controllerSessionId String?
  controllerSession   Session?         @relation("ControllerExecutions", fields: [controllerSessionId], references: [id], onDelete: SetNull)
  machineId           String
  provider            String
  model               String?
  childSessionId      String?
  executionType       String           @default("initial")
  resumeMessage       String?
  status              String
  attempt             Int              @default(1)
  dispatchToken       String           @unique
  timeoutMs           Int?
  pid                 Int?
  startedAt           DateTime?
  finishedAt          DateTime?
  exitCode            Int?
  signal              String?
  outputSummary       String?
  outputText          String?
  /// Shell executions only: what the command wrote to stderr (`outputText` holds its stdout)
  stderrText          String?
  /// Shell executions only: where the daemon saved the full stdout when it was too long to keep
  /// here ({ path, chars, lines, complete }); `outputText` is then its last part
  stdoutFile          Json?
  /// Shell executions only: the same for stderr
  stderrFile          Json?
  /// Transfer executions only: what arrived at the target ({ path, kind, bytes, files, sha256 })
  transferResult      Json?
  /// The result, sealed by the daemon with the orchestrator key. The output fields above stay
  /// empty beside it: the server cannot read what the execution did
  sealedResult        String?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([runId, status, createdAt])
  @@index([taskId, status, createdAt])
  @@index([machineId, status, createdAt])
  @@index([workerSessionId])
  @@index([controllerSessionId])
}

/// A finished run's callback that a session's agent has not been told yet: written in the
/// transaction that ends the run, one for each session of its current round, and deleted once
/// the session's CLI reports the agent has it. The session is a plain id, so the callback
/// outlives it for a session that continues it
model OrchestratorRunCallback {
  runId     String
  run       OrchestratorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sessionId String
  /// The run's updatedAt as it ended. An agent that saw the run at or after this has the round
  endedAt   DateTime

  @@id([runId, sessionId])
  @@index([sessionId])
}

model SessionCapabilities {
  sessionId String   @id
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payload   String
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SessionMessage {
  id            String                       @id @default(cuid())
  sessionId     String
  session       Session                      @relation(fields: [sessionId], references: [id])
  localId       String?
  seq           Int
  /// [SessionMessageContent]
  content       Json
  sentBy        String?
  sentByName    String?
  /// What the sender says the record is, in the clear beside its ciphertext: "text" for words the
  /// user or the agent wrote, "other" for the rest (tool calls, thinking, events); null when unsaid
  kind          String?
  deliveryIssue SessionMessageDeliveryIssue?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([sessionId, localId])
  @@index([sessionId, seq])
}

model SessionPendingMessage {
  id               String    @id @default(cuid())
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  localId          String
  /// [SessionMessageContent]
  content          Json
  sentBy           String?
  sentByName       String?
  trackCliDelivery Boolean   @default(false)
  pinnedAt         DateTime?
  pausedAt         DateTime?
  /// Scheduled delivery time; null means deliver as soon as the queue allows.
  deliverAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sessionId, localId])
  @@index([sessionId, pinnedAt, createdAt])
  @@index([sessionId, pausedAt, pinnedAt, createdAt])
  @@index([deliverAt, pausedAt])
}

model SessionMessageDeliveryIssue {
  id               String                            @id @default(cuid())
  sessionMessageId String                            @unique
  sessionMessage   SessionMessage                    @relation(fields: [sessionMessageId], references: [id], onDelete: Cascade)
  status           SessionMessageDeliveryIssueStatus
  reason           String?
  extra            Json?

  @@index([status])
}

//
// Github
//

model GithubUser {
  id           String    @id
  /// [GitHubProfile]
  profile      Json
  token        Bytes?
  refreshToken Bytes?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Account      Account[]
}

model GithubOrganization {
  id        String   @id
  /// [GitHubOrg]
  profile   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
  key       String   @id @default(cuid())
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model RepeatKey {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model SimpleCache {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
  id        String   @id @default(cuid())
  key       String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])
  /// [UsageReportData]
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, sessionId, key])
  @@index([accountId])
  @@index([sessionId])
}

//
// Machines
//

model Machine {
  id                 String      @id
  accountId          String
  account            Account     @relation(fields: [accountId], references: [id])
  metadata           String // Encrypted - contains static machine info
  metadataVersion    Int         @default(0)
  daemonState        String? // Encrypted - contains dynamic daemon state
  daemonStateVersion Int         @default(0)
  dataEncryptionKey  Bytes?
  /// The account's orchestrator key, sealed by the app with this machine's data key
  orchestratorKey    String?
  seq                Int         @default(0)
  active             Boolean     @default(true)
  lastActiveAt       DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  accessKeys         AccessKey[]

  @@unique([accountId, id])
  @@index([accountId])
}

model UploadedFile {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  path      String
  width     Int?
  height    Int?
  thumbhash String?
  reuseKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, path])
  @@index([accountId])
}

model ServiceAccountToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vendor     String
  token      Bytes // Encrypted token
  metadata   Json? // Optional vendor metadata
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([accountId, vendor])
  @@index([accountId])
}

//
// Artifacts
//

model Artifact {
  id                String   @id // UUID provided by client
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])
  header            Bytes // Encrypted header (can contain JSON)
  headerVersion     Int      @default(0)
  body              Bytes // Encrypted body
  bodyVersion       Int      @default(0)
  dataEncryptionKey Bytes // Encryption key for this artifact
  seq               Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, updatedAt(sort: Desc)])
}

//
// Access Keys
//

model AccessKey {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  machineId   String
  machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  data        String // Encrypted data
  dataVersion Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, machineId, sessionId])
  @@index([accountId])
  @@index([sessionId])
  @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
  none
  requested
  pending
  friend
  rejected
}

model UserRelationship {
  fromUserId     String
  fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status         RelationshipStatus @default(pending)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  acceptedAt     DateTime?
  lastNotifiedAt DateTime?

  @@id([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
  id        String   @id @default(cuid())
  userId    String
  user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  counter   BigInt
  repeatKey String?
  /// [FeedBody]
  body      Json
  badge     Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, counter])
  @@unique([userId, repeatKey])
  @@index([userId, counter(sort: Desc)])
}

//
// Key-Value Storage
//

model UserKVStore {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key       String // Unencrypted for indexing
  value     Bytes? // Encrypted value, null when "deleted"
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, key])
  @@index([accountId])
}

//
// Session Sharing
//

enum ShareAccessLevel {
  view
  edit
  admin
}

enum SessionMessageDeliveryIssueStatus {
  waiting
  error
}

model SessionShare {
  id               String                  @id @default(cuid())
  sessionId        String
  session          Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sharedByUserId   String
  sharedByUser     Account                 @relation("SharedBySessions", fields: [sharedByUserId], references: [id])
  sharedWithUserId String
  sharedWithUser   Account                 @relation("SharedWithSessions", fields: [sharedWithUserId], references: [id])
  accessLevel      ShareAccessLevel        @default(view)
  encryptedDataKey Bytes
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  accessLogs       SessionShareAccessLog[]

  @@unique([sessionId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
  @@index([sessionId])
}

model PublicSessionShare {
  id                String                   @id @default(cuid())
  sessionId         String                   @unique
  session           Session                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdByUser     Account                  @relation("PublicSessionShares", fields: [createdByUserId], references: [id])
  tokenHash         Bytes                    @unique
  encryptedDataKey  Bytes
  expiresAt         DateTime?
  maxUses           Int?
  useCount          Int                      @default(0)
  isConsentRequired Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  accessLogs        PublicShareAccessLog[]
  blockedUsers      PublicShareBlockedUser[]
}

model SessionShareAccessLog {
  id         String       @id @default(cuid())
  shareId    String
  share      SessionShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId     String?
  accessedAt DateTime     @default(now())
}

model PublicShareAccessLog {
  id            String             @id @default(cuid())
  publicShareId String
  publicShare   PublicSessionShare @relation(fields: [publicShareId], references: [id], onDelete: Cascade)
  userId        String?
  ipAddress     String?
  userAgent     String?
  accessedAt    DateTime           @default(now())
}

model PublicShareBlockedUser {
  id            String             @id @default(cuid())
  publicShareId String
  publicShare   PublicSessionShare @relation(fields: [publicShareId], references: [id], onDelete: Cascade)
  userId        String
  user          Account            @relation(fields: [userId], references: [id])
  reason        String?
  blockedAt     DateTime           @default(now())

  @@unique([publicShareId, userId])
}

//
// OTA updates (expo-updates protocol, served by otaRoutes)
//

/// A file of an OTA update, stored in S3 at ota/assets/<hash>. Shared by every update that has it.
model OtaAsset {
  /// Base64url SHA-256 of the file, as the manifest gives it
  hash        String   @id
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

model OtaUpdate {
  /// UUID, the manifest's id
  id              String   @id
  channel         String
  platform        String
  runtimeVersion  String
  /// "update", or "rollBackToEmbedded" to send the app back to the JS in its binary
  kind            String
  /// [OtaUpdateContent] launch asset, assets and expoClient config; null for rollBackToEmbedded
  content         Json?
  message         String?
  gitCommit       String?
  /// The update this one republishes (a rollback to it)
  republishedFrom String?
  createdAt       DateTime @default(now())

  @@index([channel, platform, runtimeVersion, createdAt])
}
