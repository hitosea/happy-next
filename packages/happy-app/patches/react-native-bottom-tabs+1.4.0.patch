--- a/node_modules/react-native-bottom-tabs/ios/Extensions.swift
+++ b/node_modules/react-native-bottom-tabs/ios/Extensions.swift
@@ -53,6 +53,47 @@ extension PlatformImage {
   }
 }
 
+#if os(iOS)
+extension UIImage {
+  /// The color the system itself draws tab bar items with on this OS version.
+  /// iOS 26 tab bars ignore the per-item tint colors and paint every item with a
+  /// vibrant label color, so an icon whose dot badge is baked into the bitmap has to
+  /// use that same color to keep looking like its neighbours. Older systems respect
+  /// the tint colors, so there the app provided tint stays in charge.
+  static func systemTabItemTint(for colorScheme: ColorScheme) -> UIColor? {
+    if #available(iOS 26.0, *) {
+      let style: UIUserInterfaceStyle = colorScheme == .dark ? .dark : .light
+      return UIColor.label
+        .resolvedColor(with: UITraitCollection(userInterfaceStyle: style))
+        .withAlphaComponent(0.9)
+    }
+    return nil
+  }
+
+  func addingDotBadge(tintColor: UIColor?, colorScheme: ColorScheme) -> UIImage {
+    let verticalInset: CGFloat = 6
+    let horizontalInset: CGFloat = 6
+    let canvasSize = CGSize(
+      width: size.width + horizontalInset * 2,
+      height: size.height + verticalInset * 2
+    )
+    let renderer = UIGraphicsImageRenderer(size: canvasSize)
+    let rendered = renderer.image { _ in
+      let baseImage = (UIImage.systemTabItemTint(for: colorScheme) ?? tintColor).map {
+        withTintColor($0, renderingMode: .alwaysOriginal)
+      } ?? self
+      baseImage.draw(at: CGPoint(x: horizontalInset, y: verticalInset))
+
+      UIColor.systemRed.setFill()
+      UIBezierPath(
+        ovalIn: CGRect(x: horizontalInset + size.width - 2, y: 0, width: 8, height: 8)
+      ).fill()
+    }
+    return rendered.withRenderingMode(.alwaysOriginal)
+  }
+}
+#endif
+
 extension View {
 #if os(macOS)
   @MainActor
