+      DispatchQueue.main.async {
+        // Backported from expo-dev-menu 57: under the scene life cycle (required by the iOS 27 SDK)
+        // a window made with only a frame belongs to no scene and is never shown, so the shake and
+        // three-finger gestures opened nothing. Attach it to the active scene before showing it.
+        if self.window?.windowScene == nil {
