{
  "name": "happy-app",
  "main": "index.ts",
  "version": "2.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:connected-device": "yarn ios -d",
    "submit": "eas submit --platform ios",
    "web": "expo start --web",
    "test": "vitest",
    "prebuild": "rm -rf android ios && expo prebuild",
    "ota": "APP_ENV=preview NODE_ENV=preview tsx sources/scripts/parseChangelog.ts && yarn typecheck && eas update --branch preview",
    "ota:production": "npx eas-cli@latest workflow:run ota.yaml",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && npx setup-skia-web public",
    "generate-theme": "tsx sources/theme.gen.ts",
    "// ==== Development/Preview/Production Variants ====": "",
    "ios:dev": "cross-env APP_ENV=development expo run:ios",
    "ios:preview": "cross-env APP_ENV=preview expo run:ios",
    "ios:production": "cross-env APP_ENV=production expo run:ios",
    "android:dev": "cross-env APP_ENV=development expo run:android",
    "android:preview": "cross-env APP_ENV=preview expo run:android",
    "android:production": "cross-env APP_ENV=production expo run:android",
    "start:dev": "cross-env APP_ENV=development expo start",
    "start:preview": "cross-env APP_ENV=preview expo start",
    "start:production": "cross-env APP_ENV=production expo start",
    "// ==== Desktop (Tauri) Variants ====": "",
    "tauri:dev": "cross-env APP_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:macos": "cross-env APP_ENV=development \"RUSTFLAGS=-C link-arg=-Wl,-rpath,/usr/lib/swift\" tauri dev --features tauri-plugin-notifications/notify-rust --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:inspect": "cross-env HAPPY_OPEN_DEVTOOLS=1 APP_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build:dev": "cross-env APP_ENV=development tauri build --config src-tauri/tauri.dev.conf.json",
    "tauri:build:preview": "cross-env APP_ENV=preview tauri build --config src-tauri/tauri.preview.conf.json",
    "tauri:build:production": "cross-env APP_ENV=production tauri build",
    "tauri:build:updater-test": "cross-env HAPPY_UPDATER_TEST_MODE=1 APP_ENV=production tauri build --config src-tauri/tauri.updater-test.conf.json",
    "tauri:build:macos:universal": "cross-env APP_ENV=production tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:windows:x64": "cross-env APP_ENV=production tauri build --target x86_64-pc-windows-msvc --bundles msi,nsis",
    "tauri:build:windows:arm64": "cross-env APP_ENV=production tauri build --target aarch64-pc-windows-msvc --bundles msi,nsis",
    "desktop:updater:manifest": "node sources/scripts/generateDesktopUpdateManifest.cjs",
    "desktop:icons": "node sources/scripts/generateDesktopIcons.cjs",
    "brand:assets": "node sources/scripts/generateBrandAssets.cjs && yarn desktop:icons && yarn desktop:icon:macos",
    "desktop:icon:macos": "node sources/scripts/compileMacosIcon.cjs"
  },
  "jest": {
    "preset": "jest-expo"
  },
